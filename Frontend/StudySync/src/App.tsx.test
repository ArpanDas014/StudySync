                    <div style={{ flex: 1, padding: '24px', display: 'flex', flexDirection: 'column', gap: '16px' }}>
                      <div style={{ background: 'var(--bg)', padding: '16px', borderRadius: '12px 12px 12px 0', alignSelf: 'flex-start', maxWidth: '80%' }}>
                        I've looked at your Red-Black tree insertion code. The issue is in the rotation logic on line 42.
                      </div>
                      <div style={{ background: 'var(--accent)', color: 'white', padding: '16px', borderRadius: '12px 12px 0 12px', alignSelf: 'flex-end', maxWidth: '80%' }}>
                        Ah, I see it now! I was forgetting to update the parent pointer. Thanks Sarah!
                      </div>
                    </div>
                    <div style={{ padding: '16px', borderTop: '1px solid var(--border)', display: 'flex', gap: '12px' }}>
                      <input type="text" className="soft-input" placeholder="Type your doubt..." style={{ marginBottom: 0, flex: 1 }} />
                      <button className="btn-primary">Send</button>
                    </div>
                  </div>
                </div>
              )}

            </div>
          </motion.div>
        )}

        {/* Settings */}
        {view === 'settings' && (
          <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} className="lib-layout">
            
              <div className="lib-sidebar">
              <div className="lib-filter-group">
                <span className="eyebrow">Preferences</span>
                <button className={`lib-filter-btn ${settingsTab === 'appearance' ? 'active' : ''}`} onClick={() => setSettingsTab('appearance')}>Appearance</button>
                <button className={`lib-filter-btn ${settingsTab === 'notifications' ? 'active' : ''}`} onClick={() => setSettingsTab('notifications')}>Notifications</button>
                
                <span className="eyebrow" style={{ marginTop: '24px' }}>Account & Data</span>
                <button className={`lib-filter-btn ${settingsTab === 'security' ? 'active' : ''}`} onClick={() => setSettingsTab('security')}>Security</button>
                <button className={`lib-filter-btn ${settingsTab === 'billing' ? 'active' : ''}`} onClick={() => setSettingsTab('billing')}>Billing & Plan</button>
                <button className={`lib-filter-btn ${settingsTab === 'integrations' ? 'active' : ''}`} onClick={() => setSettingsTab('integrations')}>Integrations</button>
              </div>
            </div>

            <div className="lib-main" style={{ maxWidth: '800px' }}>
              <div className="lib-topbar" style={{ marginBottom: '32px' }}>
                <h1 className="sub-title" style={{ margin: 0 }}>
                  {settingsTab === 'appearance' && 'Appearance & Language'}
                  {settingsTab === 'notifications' && 'Notification Preferences'}
                  {settingsTab === 'security' && 'Account Security'}
                  {settingsTab === 'billing' && 'Billing & Subscription'}
                  {settingsTab === 'integrations' && 'Connected Apps'}
                </h1>
              </div>

              {settingsTab === 'appearance' && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: '24px' }}>
                  <div className="soft-card">
                    <h3 style={{ fontSize: '1.2rem', marginBottom: '8px' }}>Theme</h3>
                    <p style={{ opacity: 0.7, marginBottom: '24px' }}>Choose your preferred lighting for StudySync.</p>
                    <div style={{ display: 'flex', gap: '16px' }}>
                      <button className="btn-outline" style={{ flex: 1, borderColor: 'var(--accent)' }}>System Default</button>
                      <button className="btn-outline" style={{ flex: 1 }}>Light Mode �f����,U,�</button>
                      <button className="btn-outline" style={{ flex: 1 }}>Dark Mode �<U<Ɠ��</button>
                    </div>
                  </div>
                  <div className="soft-card">
                    <h3 style={{ fontSize: '1.2rem', marginBottom: '8px' }}>Language Selection</h3>
                    <p style={{ opacity: 0.7, marginBottom: '24px' }}>Choose the default language for the platform.</p>
                    <select className="soft-input" style={{ width: '100%', maxWidth: '300px' }}>
                      <option>English (US)</option>
                      <option>Spanish (ES)</option>
                      <option>French (FR)</option>
                      <option>Hindi (IN)</option>
                    </select>
                  </div>
                </div>
              )}

              {settingsTab === 'notifications' && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: '24px' }}>
                  <div className="soft-card" style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                    <div>
                      <h3 style={{ fontSize: '1.1rem', marginBottom: '4px' }}>Email Notifications</h3>
                      <p style={{ opacity: 0.7, margin: 0, fontSize: '0.9rem' }}>Receive weekly progress reports and major updates.</p>
                    </div>
                    <div style={{ width: '48px', height: '24px', background: 'var(--accent)', borderRadius: '24px', position: 'relative', cursor: 'pointer' }}>
                      <div style={{ width: '20px', height: '20px', background: 'white', borderRadius: '50%', position: 'absolute', top: '2px', right: '2px' }}></div>
                    </div>
                  </div>
                  <div className="soft-card" style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                    <div>
                      <h3 style={{ fontSize: '1.1rem', marginBottom: '4px' }}>Push Notifications</h3>
                      <p style={{ opacity: 0.7, margin: 0, fontSize: '0.9rem' }}>Real-time alerts for study groups, messages, and events.</p>
                    </div>
                    <div style={{ width: '48px', height: '24px', background: 'var(--accent)', borderRadius: '24px', position: 'relative', cursor: 'pointer' }}>
                      <div style={{ width: '20px', height: '20px', background: 'white', borderRadius: '50%', position: 'absolute', top: '2px', right: '2px' }}></div>
                    </div>
                  </div>
                  <div className="soft-card" style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                    <div>
                      <h3 style={{ fontSize: '1.1rem', marginBottom: '4px' }}>Study Focus Mode</h3>
                      <p style={{ opacity: 0.7, margin: 0, fontSize: '0.9rem' }}>Mute all notifications automatically during active study sessions.</p>
                    </div>
                    <div style={{ width: '48px', height: '24px', background: 'var(--border)', borderRadius: '24px', position: 'relative', cursor: 'pointer' }}>
                      <div style={{ width: '20px', height: '20px', background: 'white', borderRadius: '50%', position: 'absolute', top: '2px', left: '2px' }}></div>
                    </div>
                  </div>
                </div>
              )}

              {settingsTab === 'privacy' && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: '24px' }}>
                  <div className="soft-card">
                    <h3 style={{ fontSize: '1.2rem', marginBottom: '8px' }}>Profile Visibility</h3>
                    <p style={{ opacity: 0.7, marginBottom: '24px' }}>Control who can see your profile and study statistics.</p>
                    <select className="soft-input" style={{ width: '100%', maxWidth: '300px' }}>
                      <option>Public (Everyone)</option>
                      <option>Friends Only</option>
                      <option>Private</option>
                    </select>
                  </div>
                  <div className="soft-card">
                    <h3 style={{ fontSize: '1.2rem', marginBottom: '8px' }}>Data Collection</h3>
                    <p style={{ opacity: 0.7, marginBottom: '24px' }}>Allow StudySync AI to analyze your learning patterns to provide better insights.</p>
                    <button className="btn-primary" style={{ background: 'var(--border)', color: 'var(--ink)' }}>Disable AI Analysis</button>
                  </div>
                </div>
              )}

              {settingsTab === 'security' && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: '24px' }}>
                  <div className="soft-card">
                    <h3 style={{ fontSize: '1.2rem', marginBottom: '8px' }}>Change Password</h3>
                    <div style={{ display: 'flex', flexDirection: 'column', gap: '12px', maxWidth: '400px' }}>
                      <input type="password" placeholder="Current Password" className="soft-input" style={{ marginBottom: 0 }} />
                      <input type="password" placeholder="New Password" className="soft-input" style={{ marginBottom: 0 }} />
                      <input type="password" placeholder="Confirm New Password" className="soft-input" style={{ marginBottom: 0 }} />
                      <button className="btn-primary" style={{ marginTop: '8px' }}>Update Password</button>
                    </div>
                  </div>
                  <div className="soft-card" style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                    <div>
                      <h3 style={{ fontSize: '1.2rem', marginBottom: '4px' }}>Two-Factor Authentication (2FA)</h3>
                      <p style={{ opacity: 0.7, margin: 0, fontSize: '0.9rem' }}>Add an extra layer of security to your account.</p>
                    </div>
                    <button className="btn-outline" style={{ borderColor: '#78C2AD', color: '#78C2AD' }}>Enable 2FA</button>
                  </div>
                </div>
              )}

            </div>
          </motion.div>
        )}

        {/* Advanced Tools */}
        {view === 'advanced' && (
          <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} style={{ maxWidth: '1200px', margin: '0 auto', paddingTop: '40px' }}>
            
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '40px' }}>
              <div>
                <p className="eyebrow">Power User</p>
                <h1 className="sub-title" style={{ margin: 0 }}>Advanced Tools</h1>
              </div>
              {activeTool && (
                <button className="btn-outline" onClick={() => setActiveTool(null)}>
                  �,��Ǫ�,U,� Back to Launchpad
                </button>
              )}
            </div>

            {/* Launchpad Grid */}
            {!activeTool && (
              <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(220px, 1fr))', gap: '24px' }}>
                
                {[
                  { id: 'pdf', icon: '�<U�ǣ,�', title: 'PDF Annotation', desc: 'Highlight and annotate' },
                  { id: 'ocr', icon: '�<U�ǣ,U', title: 'OCR for Notes', desc: 'Extract text from images' },
                  { id: 'voice', icon: '�<U<\����,U,�', title: 'Voice-to-Text', desc: 'Dictate your notes' },
                  { id: 'tts', icon: '�<U�ǥ<�', title: 'Text-to-Speech', desc: 'Listen to your readings' },
                  { id: 'mindmap', icon: '�<U,�,�', title: 'AI Mind Map', desc: 'Generate concept maps' },
                  { id: 'citation', icon: '�<U�ǣ���', title: 'Citation Gen', desc: 'Auto-format references' },
                  { id: 'latex', icon: '�f���', title: 'Formula Editor', desc: 'Write LaTeX equations' },
                  { id: 'compiler', icon: '�<U���,W', title: 'Code Compiler', desc: 'Run code in browser' },
                  { id: 'plagiarism', icon: '�<U��Q,��,U,�', title: 'Plagiarism Check', desc: 'Verify originality' },
                  { id: 'resume', icon: '�<U����ǥ', title: 'Resume Builder', desc: 'Craft your CV' }
                ].map(tool => (
                  <motion.div 
                    key={tool.id}
                    whileHover={{ scale: 1.05 }}
                    whileTap={{ scale: 0.95 }}
                    className="soft-card dash-insights"
                    style={{ cursor: 'pointer', padding: '32px 24px', textAlign: 'center', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '16px' }}
                    onClick={() => setActiveTool(tool.id)}
                  >
                    <span style={{ fontSize: '3rem' }}>{tool.icon}</span>
                    <strong style={{ fontSize: '1.2rem' }}>{tool.title}</strong>
                    <span style={{ fontSize: '0.9rem', opacity: 0.7 }}>{tool.desc}</span>
                  </motion.div>
                ))}

              </div>
            )}

            {/* Code Compiler Mock */}
            {activeTool === 'compiler' && (
              <div className="soft-card" style={{ padding: 0, overflow: 'hidden', border: '1px solid var(--border)' }}>
                <div style={{ background: '#1e1e1e', color: '#d4d4d4', padding: '12px 24px', display: 'flex', justifyContent: 'space-between', alignItems: 'center', borderBottom: '1px solid #333' }}>
                  <span style={{ fontFamily: 'monospace', fontSize: '14px' }}>main.py - Python 3.10</span>
                  <button className="btn-primary" style={{ background: '#78C2AD', color: '#1e1e1e', padding: '6px 16px', fontSize: '0.9rem' }}>���,b Run Code</button>
                </div>
                <div style={{ display: 'flex', height: '500px' }}>
                  <div style={{ flex: 2, background: '#1e1e1e', padding: '24px', fontFamily: 'monospace', fontSize: '14px', borderRight: '1px solid #333' }}>
                    <div style={{ color: '#569cd6' }}>def <span style={{ color: '#dcdcaa' }}>binary_search</span><span style={{ color: '#d4d4d4' }}>(arr, target):</span></div>
                    <div style={{ paddingLeft: '24px' }}>left, right = <span style={{ color: '#b5cea8' }}>0</span>, <span style={{ color: '#569cd6' }}>len</span>(arr) - <span style={{ color: '#b5cea8' }}>1</span></div>
                    <div style={{ paddingLeft: '24px', color: '#c586c0' }}>while <span style={{ color: '#d4d4d4' }}>left &lt;= right:</span></div>
                    <div style={{ paddingLeft: '48px' }}>mid = (left + right) // <span style={{ color: '#b5cea8' }}>2</span></div>
                    <div style={{ paddingLeft: '48px', color: '#c586c0' }}>if <span style={{ color: '#d4d4d4' }}>arr[mid] == target:</span></div>
                    <div style={{ paddingLeft: '72px', color: '#c586c0' }}>return <span style={{ color: '#d4d4d4' }}>mid</span></div>
                    <div style={{ paddingLeft: '48px', color: '#c586c0' }}>elif <span style={{ color: '#d4d4d4' }}>arr[mid] &lt; target:</span></div>
                    <div style={{ paddingLeft: '72px' }}>left = mid + <span style={{ color: '#b5cea8' }}>1</span></div>
                    <div style={{ paddingLeft: '48px', color: '#c586c0' }}>else:</div>
                    <div style={{ paddingLeft: '72px' }}>right = mid - <span style={{ color: '#b5cea8' }}>1</span></div>
                    <div style={{ paddingLeft: '24px', color: '#c586c0' }}>return <span style={{ color: '#569cd6' }}>-1</span></div>
                    <br />
                    <div><span style={{ color: '#569cd6' }}>print</span>(binary_search([<span style={{ color: '#b5cea8' }}>1</span>, <span style={{ color: '#b5cea8' }}>3</span>, <span style={{ color: '#b5cea8' }}>5</span>, <span style={{ color: '#b5cea8' }}>7</span>, <span style={{ color: '#b5cea8' }}>9</span>], <span style={{ color: '#b5cea8' }}>5</span>))</div>
                  </div>
                  <div style={{ flex: 1, background: '#000000', color: '#ffffff', padding: '24px', fontFamily: 'monospace', fontSize: '14px' }}>
                    <div style={{ opacity: 0.5, marginBottom: '16px' }}>Terminal output...</div>
                    <div style={{ color: '#78C2AD' }}>$ python main.py</div>
                    <div>2</div>
                    <br />
                    <div style={{ color: '#78C2AD' }}>Process exited with code 0</div>
                  </div>
                </div>
              </div>
            )}

            {/* AI Mind Map Mock */}
            {activeTool === 'mindmap' && (
              <div className="soft-card" style={{ height: '600px', display: 'flex', flexDirection: 'column', position: 'relative' }}>
                <div style={{ padding: '24px', borderBottom: '1px solid var(--border)', display: 'flex', gap: '16px' }}>
                  <input type="text" className="soft-input" placeholder="Topic to map (e.g., Photosynthesis)..." style={{ marginBottom: 0, flex: 1 }} />
                  <button className="btn-primary">Generate �<U,�,�</button>
                </div>
                <div style={{ flex: 1, position: 'relative', overflow: 'hidden', background: 'var(--bg)' }}>
                  {/* Mock Diagram */}
                  <div style={{ position: 'absolute', top: '50%', left: '50%', transform: 'translate(-50%, -50%)', background: '#457B9D', color: 'white', padding: '24px 32px', borderRadius: '100px', fontSize: '1.5rem', zIndex: 2, boxShadow: '0 8px 32px rgba(0,0,0,0.2)' }}>
                    Cellular Biology
                  </div>
                  
                  {/* Nodes & Lines */}
                  <div style={{ position: 'absolute', top: '20%', left: '30%', transform: 'translate(-50%, -50%)', background: 'var(--surface)', padding: '16px 24px', borderRadius: '100px', border: '2px solid #457B9D', zIndex: 2 }}>Mitosis</div>
                  <svg style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', zIndex: 1 }}>
                    <line x1="50%" y1="50%" x2="30%" y2="20%" stroke="#457B9D" strokeWidth="3" strokeDasharray="5,5" />
                  </svg>

                  <div style={{ position: 'absolute', top: '25%', left: '70%', transform: 'translate(-50%, -50%)', background: 'var(--surface)', padding: '16px 24px', borderRadius: '100px', border: '2px solid #457B9D', zIndex: 2 }}>Meiosis</div>
                  <svg style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', zIndex: 1 }}>
                    <line x1="50%" y1="50%" x2="70%" y2="25%" stroke="#457B9D" strokeWidth="3" strokeDasharray="5,5" />
                  </svg>

                  <div style={{ position: 'absolute', top: '75%', left: '40%', transform: 'translate(-50%, -50%)', background: 'var(--surface)', padding: '16px 24px', borderRadius: '100px', border: '2px solid #457B9D', zIndex: 2 }}>Organelles</div>
                  <svg style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: '100%', zIndex: 1 }}>
                    <line x1="50%" y1="50%" x2="40%" y2="75%" stroke="#457B9D" strokeWidth="3" strokeDasharray="5,5" />
                  </svg>
                </div>
              </div>
            )}

            {/* Resume Builder Mock */}
            {activeTool === 'resume' && (
              <div style={{ display: 'flex', gap: '24px', height: '600px' }}>
                <div className="soft-card" style={{ flex: 1, padding: '24px', overflowY: 'auto', display: 'flex', flexDirection: 'column', gap: '16px' }}>
                  <h3 style={{ fontSize: '1.2rem', marginBottom: '8px' }}>Personal Details</h3>
                  <input type="text" className="soft-input" placeholder="Full Name" defaultValue="Student Name" />
                  <input type="text" className="soft-input" placeholder="Email Address" defaultValue="student@university.edu" />
                  <input type="text" className="soft-input" placeholder="LinkedIn URL" />
                  
                  <h3 style={{ fontSize: '1.2rem', margin: '16px 0 8px' }}>Experience</h3>
                  <textarea className="soft-input" rows={4} placeholder="Describe your experience..."></textarea>
                  
                  <button className="btn-primary" style={{ marginTop: '16px' }}>Generate PDF</button>
                </div>
                <div className="soft-card" style={{ flex: 1, background: '#f8f9fa', padding: '40px', display: 'flex', justifyContent: 'center' }}>
                  {/* A4 Preview */}
                  <div style={{ width: '100%', maxWidth: '400px', background: 'white', boxShadow: '0 10px 40px rgba(0,0,0,0.1)', padding: '32px', color: 'black' }}>
                    <h1 style={{ fontSize: '1.8rem', textAlign: 'center', marginBottom: '8px', borderBottom: '2px solid #457B9D', paddingBottom: '8px' }}>Student Name</h1>
                    <p style={{ textAlign: 'center', fontSize: '0.8rem', opacity: 0.7, marginBottom: '24px' }}>student@university.edu | linkedin.com/in/student</p>
                    <h2 style={{ fontSize: '1rem', color: '#457B9D', marginBottom: '8px' }}>EXPERIENCE</h2>
                    <div style={{ width: '100%', height: '8px', background: '#e9ecef', borderRadius: '4px', marginBottom: '8px' }}></div>
                    <div style={{ width: '80%', height: '8px', background: '#e9ecef', borderRadius: '4px', marginBottom: '8px' }}></div>
                    <div style={{ width: '90%', height: '8px', background: '#e9ecef', borderRadius: '4px', marginBottom: '24px' }}></div>
                    <h2 style={{ fontSize: '1rem', color: '#457B9D', marginBottom: '8px' }}>EDUCATION</h2>
                    <div style={{ width: '100%', height: '8px', background: '#e9ecef', borderRadius: '4px', marginBottom: '8px' }}></div>
                    <div style={{ width: '60%', height: '8px', background: '#e9ecef', borderRadius: '4px' }}></div>
                  </div>
                </div>
              </div>
            )}

            {/* Generic Tool Mock for remaining */}
            {activeTool && !['compiler', 'mindmap', 'resume'].includes(activeTool) && (
              <div className="soft-card" style={{ padding: '64px', textAlign: 'center', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '24px' }}>
                <span style={{ fontSize: '4rem' }}>�<����,U,�</span>
                <h2 style={{ fontSize: '2rem', margin: 0 }}>Upload a File to Begin</h2>
                <p style={{ opacity: 0.7, fontSize: '1.1rem', maxWidth: '400px' }}>
                  Drag and drop your document here to process it with our advanced AI tooling.
                </p>
                <div style={{ border: '2px dashed var(--accent)', borderRadius: '24px', padding: '64px', width: '100%', maxWidth: '600px', cursor: 'pointer', background: 'var(--bg)' }}>
                  <span style={{ fontSize: '3rem', opacity: 0.5 }}>�<U�ǣ���</span>
                  <p style={{ margin: '16px 0 0', fontWeight: 600, color: 'var(--accent)' }}>Click to Browse Files</p>
                </div>
              </div>
            )}

          </motion.div>
        )}

        {/* Admin Dashboard */}
        {view === 'admin' && (
          <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }}>
            <div style={{ marginBottom: '40px' }}>
              <p className="eyebrow" style={{ color: 'var(--ink)' }}>Admin Access</p>
              <h1 className="sub-title">System Dashboard</h1>
            </div>

            <div className="admin-stats-grid">
              <div className="admin-stat">
                <span className="eyebrow" style={{ margin: 0 }}>Total Users</span>
                <span className="admin-stat-val">12,450</span>
              </div>
              <div className="admin-stat">
                <span className="eyebrow" style={{ margin: 0 }}>Active Sessions</span>
                <span className="admin-stat-val">842</span>
              </div>
              <div className="admin-stat">
                <span className="eyebrow" style={{ margin: 0 }}>System Health</span>
                <span className="admin-stat-val" style={{ color: '#046C4E' }}>99.9%</span>
              </div>
              <div className="admin-stat">
                <span className="eyebrow" style={{ margin: 0 }}>Reports</span>
                <span className="admin-stat-val" style={{ color: '#C53030' }}>3</span>
              </div>
            </div>

            <div className="admin-table-wrapper">
              <div style={{ padding: '24px', borderBottom: '1px solid var(--border)', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                <h2 style={{ fontSize: '1.25rem' }}>Recent Registrations</h2>
                <button className="btn-outline" style={{ padding: '8px 16px' }}>Export CSV</button>
              </div>
              <table className="admin-table">
                <thead>
                  <tr>
                    <th>User ID</th>
                    <th>Name</th>
                    <th>Domain</th>
                    <th>Joined</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>#U-8492</td>
                    <td>Alex Student</td>
                    <td>Computer Science</td>
                    <td>Today, 10:42 AM</td>
                    <td><span style={{ color: '#046C4E', fontWeight: 600 }}>Active</span></td>
                  </tr>
                  <tr>
                    <td>#U-8491</td>
                    <td>Sarah Jenkins</td>
                    <td>Medicine</td>
                    <td>Yesterday</td>
                    <td><span style={{ color: '#046C4E', fontWeight: 600 }}>Active</span></td>
                  </tr>
                  <tr>
                    <td>#U-8490</td>
                    <td>Mike T.</td>
                    <td>Engineering</td>
                    <td>Yesterday</td>
                    <td><span style={{ color: '#C53030', fontWeight: 600 }}>Flagged</span></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </motion.div>
        )}

      </main>
    </div>
  );
}
