            </span>
            <span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4299E1" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
              AI-Powered
            </span>
            <span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2B6CB0" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              Collaborative
            </span>
          </div>
        </motion.div>

        {/* Right Column - Animated Doodle */}
        <motion.div initial={{ x: 30, opacity: 0 }} animate={{ x: 0, opacity: 1 }} transition={{ duration: 0.6 }} style={{ display: 'flex', justifyContent: 'center' }}>
          <svg width="100%" height="auto" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg" style={{ maxWidth: '450px' }}>
            {/* Background Blob */}
            <path d="M350 200C350 282.843 282.843 350 200 350C117.157 350 50 282.843 50 200C50 117.157 117.157 50 200 50C282.843 50 350 117.157 350 200Z" fill="#FDF3E7"/>
            
            {/* Desk */}
            <rect x="80" y="300" width="240" height="12" rx="6" fill="#D3A78B"/>
            <rect x="90" y="312" width="220" height="6" fill="#B88A6E"/>
            
            {/* Person Body */}
            <path d="M160 300V240C160 217.909 177.909 200 200 200C222.091 200 240 217.909 240 240V300H160Z" fill="#F4B97C"/>
            
            {/* Head */}
            <circle cx="200" cy="160" r="35" fill="#FFCBA4"/>
            {/* Hair */}
            <path d="M165 160C165 130 180 115 200 115C220 115 235 130 235 160V190C235 210 220 220 220 220H180C180 220 165 210 165 190V160Z" fill="#2D3748"/>
            <circle cx="200" cy="155" r="35" fill="#2D3748" clipPath="url(#hair-clip)"/>
            <defs>
              <clipPath id="hair-clip">
                <rect x="150" y="100" width="100" height="60" />
              </clipPath>
            </defs>
            {/* Face details */}
            <circle cx="190" cy="155" r="3" fill="#1A202C"/>
            <circle cx="210" cy="155" r="3" fill="#1A202C"/>
            <path d="M195 170Q200 175 205 170" stroke="#1A202C" strokeWidth="2" strokeLinecap="round"/>
            
            {/* Laptop */}
            <path d="M140 300H260L240 250H160L140 300Z" fill="#4A5568"/>
            <rect x="165" y="255" width="70" height="40" rx="2" fill="#E2E8F0"/>
            <rect x="130" y="300" width="140" height="8" rx="4" fill="#2D3748"/>

            {/* Floating Animated Elements */}
            <motion.g animate={{ y: [-10, 10, -10] }} transition={{ repeat: Infinity, duration: 4, ease: "easeInOut" }}>
              {/* Lightbulb */}
              <circle cx="120" cy="100" r="20" fill="#F6E05E"/>
              <path d="M110 100L130 100M115 110L125 110" stroke="#D69E2E" strokeWidth="3" strokeLinecap="round"/>
              <rect x="112" y="120" width="16" height="10" rx="3" fill="#A0AEC0"/>
              <path d="M120 70V60M95 90L85 85M145 90L155 85" stroke="#F6E05E" strokeWidth="3" strokeLinecap="round"/>
            </motion.g>

            <motion.g animate={{ y: [10, -10, 10] }} transition={{ repeat: Infinity, duration: 5, ease: "easeInOut" }}>
              {/* Calendar */}
              <rect x="260" y="120" width="60" height="60" rx="8" fill="#FFFFFF" stroke="#E2E8F0" strokeWidth="4"/>
              <rect x="260" y="120" width="60" height="20" fill="#FC8181" rx="4"/>
              <circle cx="275" cy="115" r="4" fill="#4A5568"/>
              <circle cx="305" cy="115" r="4" fill="#4A5568"/>
              <rect x="270" y="150" width="10" height="10" rx="2" fill="#E2E8F0"/>
              <rect x="285" y="150" width="10" height="10" rx="2" fill="#4A5D3A"/>
              <rect x="300" y="150" width="10" height="10" rx="2" fill="#E2E8F0"/>
              <rect x="270" y="165" width="10" height="10" rx="2" fill="#E2E8F0"/>
              <rect x="285" y="165" width="10" height="10" rx="2" fill="#E2E8F0"/>
            </motion.g>

            <motion.g animate={{ y: [-5, 5, -5] }} transition={{ repeat: Infinity, duration: 3, ease: "easeInOut" }}>
              {/* Checklist */}
              <rect x="70" y="170" width="50" height="70" rx="6" fill="#FFFFFF" stroke="#E2E8F0" strokeWidth="4"/>
              <rect x="80" y="185" width="10" height="10" rx="2" fill="#48BB78"/>
              <rect x="95" y="188" width="15" height="4" rx="2" fill="#A0AEC0"/>
              
              <rect x="80" y="205" width="10" height="10" rx="2" fill="#E2E8F0"/>
              <rect x="95" y="208" width="15" height="4" rx="2" fill="#E2E8F0"/>
              
              <rect x="80" y="225" width="10" height="10" rx="2" fill="#E2E8F0"/>
              <rect x="95" y="228" width="15" height="4" rx="2" fill="#E2E8F0"/>
            </motion.g>
          </svg>
        </motion.div>
      </section>

      {/* Stats Banner */}
      <section className="landing-stats" style={{ marginBottom: '80px' }}>
        <div className="landing-stat-item">
          <div className="stat-icon" style={{ background: 'linear-gradient(135deg, #E6F3E6, #C8E6C9)' }}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2E7D32" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
          </div>
          <div style={{ textAlign: 'left' }}>
            <h3>10K+</h3>
            <p>Active Students</p>
          </div>
        </div>
        <div className="landing-stat-item">
          <div className="stat-icon" style={{ background: 'linear-gradient(135deg, #E3F2FD, #BBDEFB)' }}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1565C0" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
          </div>
          <div style={{ textAlign: 'left' }}>
            <h3>5K+</h3>
            <p>Resources Shared</p>
          </div>
        </div>
        <div className="landing-stat-item">
          <div className="stat-icon" style={{ background: 'linear-gradient(135deg, #FFF3E0, #FFE0B2)' }}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E65100" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          </div>
          <div style={{ textAlign: 'left' }}>
            <h3>98%</h3>
            <p>Satisfaction Rate</p>
          </div>
        </div>
        <div className="landing-stat-item">
          <div className="stat-icon" style={{ background: 'linear-gradient(135deg, #F3E5F5, #E1BEE7)' }}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#6A1B9A" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"></rect><circle cx="12" cy="5" r="2"></circle><path d="M12 7v4"></path><line x1="8" y1="16" x2="8" y2="16"></line><line x1="16" y1="16" x2="16" y2="16"></line></svg>
          </div>
          <div style={{ textAlign: 'left' }}>
            <h3>24/7</h3>
            <p>AI Study Assistant</p>
          </div>
        </div>
      </section>
      
    </div>
  );
}

function Workspace({ view, setView, tasks, setTasks, session }: any) {
  const [selectedDomain, setSelectedDomain] = useState('Computer Science');
  const [selectedSubject, setSelectedSubject] = useState('Algorithms');
  const [newTask, setNewTask] = useState('');
  const [isSidebarOpen, setIsSidebarOpen] = useState(false);
  
  const [subjectSearch, setSubjectSearch] = useState('');

  useEffect(() => {
    if (isSidebarOpen) {
      document.body.style.overflow = 'hidden';
    } else {
      document.body.style.overflow = '';
    }
    return () => { document.body.style.overflow = ''; };
  }, [isSidebarOpen]);

  const domainSubjectsMap: Record<string, string[]> = {
    'Arts': [
      'Literature', 'History', 'Philosophy', 'Visual Arts', 'Music Theory', 'Theater', 
      'Creative Writing', 'Art History', 'Linguistics', 'Film Studies', 'Classics', 'Sociology', 'Anthropology'
    ],
    'Science': [
      'Physics', 'Chemistry', 'Biology', 'Earth Science', 'Astronomy', 'Environmental Science', 
      'Genetics', 'Neuroscience', 'Ecology', 'Oceanography', 'Meteorology', 'Zoology'
    ],
    'Commerce': [
      'Accounting', 'Business Studies', 'Economics', 'Finance', 'Marketing', 'Management', 
      'Corporate Law', 'Entrepreneurship', 'Human Resources', 'Supply Chain', 'International Trade'
    ],
    'Computer Science': [
      'Algorithms', 'Data Structures', 'Web Development', 'AI', 'Machine Learning', 
      'Operating Systems', 'Databases', 'Cybersecurity', 'Networks', 'Software Engineering', 'Cloud Computing'
    ],
    'Engineering': [
      'Mechanics', 'Thermodynamics', 'Circuits', 'Robotics', 'Materials Science', 
      'Fluid Mechanics', 'Civil Engineering', 'Structural Analysis', 'Aerodynamics', 'Signals & Systems'
    ],
    'Medicine': [
      'Anatomy', 'Pharmacology', 'Pathology', 'Physiology', 'Microbiology', 'Immunology', 
      'Genetics', 'Epidemiology', 'Pediatrics', 'Surgery', 'Neurology', 'Cardiology'
    ],
  };
  const [enrolledSubjects, setEnrolledSubjects] = useState([
    { domain: 'Computer Science', subject: 'Algorithms', progress: 82 },
    { domain: 'Computer Science', subject: 'Data Structures', progress: 63 }
  ]);
  const handleEnrollSubject = (e: React.ChangeEvent<HTMLSelectElement>) => {
    const subject = e.target.value;
    if (subject && !enrolledSubjects.some(s => s.subject === subject)) {
      setEnrolledSubjects([...enrolledSubjects, { domain: selectedDomain, subject, progress: 0 }]);
    }
    e.target.value = "";
  };

  // Community Hub State
  const [forumChannel, setForumChannel] = useState('Computer Science');
  const [composerType, setComposerType] = useState<'discussion'|'question'|'poll'>('discussion');
  const [composerTitle, setComposerTitle] = useState('');
  const [composerBody, setComposerBody] = useState('');
  const [forumPosts, setForumPosts] = useState([
    {
      id: 1, type: 'announcement', author: 'Prof. Davis', role: 'Mentor', time: '1 hour ago',
      title: 'Midterm schedule updated for CS 101',
      body: 'Please check the syllabus. The midterm has been moved to next Friday to allow more time for the review session.',
      votes: 142, replies: 12
    },
    {
      id: 2, type: 'question', author: 'Alex Chen', role: 'Student', time: '2 hours ago',
      title: 'Does anyone have a good video explaining Red-Black Trees?',
      body: 'I am super stuck on the insertion and balancing rules. If someone has a visual guide, please link it below!',
      votes: 45, replies: 8
    },
    {
      id: 3, type: 'poll', author: 'Sarah Jenkins', role: 'Student', time: '5 hours ago',
      title: 'What programming language should we use for the final project?',
      body: 'Vote below so our group can start setting up the environment!',
      votes: 22, replies: 4,
      pollData: [
        { option: 'Python', votes: 15, percent: 50 },
        { option: 'TypeScript', votes: 10, percent: 33 },
        { option: 'Rust', votes: 5, percent: 17 }
      ]
    }
  ]);

  // AI Hub State
  const [aiTab, setAiTab] = useState<AITab>('tutor');

  // Event Management State
  const [eventTab, setEventTab] = useState('classes');
  const [chat, setChat] = useState([
    { role: 'ai', msg: 'Hi there! I am your AI Tutor. Let me know if you need a concept explained or code simplified.' }
  ]);
  const [chatInput, setChatInput] = useState('');
  const [flashcardFlipped, setFlashcardFlipped] = useState(false);
  
  // Group Chat State
  const [groupChat, setGroupChat] = useState([
    { role: 'other', author: 'Mike T.', msg: 'Hey guys, when are we meeting for the group project?' },
    { role: 'other', author: 'Sarah J.', msg: 'I am free after 4 PM today.' }
  ]);
  const [groupMsg, setGroupMsg] = useState('');

  // Pomodoro State
  const [pomodoroActive, setPomodoroActive] = useState(false);
  const [pomodoroReminders, setPomodoroReminders] = useState(true);
  
  // Library State
  const [libCategory, setLibCategory] = useState('all');

  // Analytics State
  const [analyticsReport, setAnalyticsReport] = useState('weekly');

  // Search State
  const [searchQuery, setSearchQuery] = useState('');
  const [searchFilter, setSearchFilter] = useState('all');

  // Mentor State
  const [mentorTab, setMentorTab] = useState('find');

  // Settings State
  const [settingsTab, setSettingsTab] = useState('appearance');

  // Sidebar State
  const [expandedSections, setExpandedSections] = useState<string[]>(['Main', 'Learning & Planning']);
  const toggleSection = (title: string) => {
    setExpandedSections(prev => 
      prev.includes(title) ? prev.filter(t => t !== title) : [...prev, title]
    );
  };

  // Advanced Tools State
  const [activeTool, setActiveTool] = useState<string | null>(null);

  // Drive State
  const [driveCategory, setDriveCategory] = useState('my-drive');

  // Goals & Gamification State
  const [goalCategory, setGoalCategory] = useState('weekly');
  const [gamifiedGoals, setGamifiedGoals] = useState([
    { id: 1, title: 'Complete Physics Problem Set', xp: 50, done: false },
    { id: 2, title: 'Attend Math Study Group', xp: 30, done: false },
    { id: 3, title: 'Read 2 chapters of Biology', xp: 40, done: true },
  ]);
  
  // Quiz Module State
  const [isTakingQuiz, setIsTakingQuiz] = useState(false);
  const [quizSelection, setQuizSelection] = useState<number | null>(null);

  const completed = tasks.filter((t: any) => t.done).length;
  const progress = tasks.length > 0 ? Math.round((completed / tasks.length) * 100) : 0;

  const navSections = [
    {
      title: 'Main',
      items: [
        { id: 'dashboard', label: 'Dashboard' },
        { id: 'search', label: 'Smart Search' },
        { id: 'notifications', label: 'Notifications (3)' }
      ]
    },
    {
      title: 'Learning & Planning',
      items: [
        { id: 'planner', label: 'Study Planner' },
        { id: 'quiz', label: 'Quiz Module' },
        { id: 'groups', label: 'Study Groups' }
      ]
    },
    {
      title: 'Analytics & Tools',
      items: [
        { id: 'analytics', label: 'Analytics' },
        { id: 'visuals', label: 'Progress Visuals' },
        { id: 'advanced', label: 'Advanced Tools' },
        { id: 'ai', label: 'AI Hub' }
      ]
    },
    {
      title: 'Resources',
      items: [
        { id: 'files', label: 'Cloud Drive' },
        { id: 'library', label: 'Resource Library' },
        { id: 'notes', label: 'Shared Notes' }
      ]
    },
    {
      title: 'Community',
      items: [
        { id: 'doubt', label: 'Community Hub' },
        { id: 'mentors', label: 'Mentor System' },
        { id: 'events', label: 'Event Management' }
      ]
    },
    {
      title: 'Account',
      items: [
        { id: 'profile', label: 'Student Profile' },
        { id: 'settings', label: 'Settings' }
      ]
    }
  ];

  const domains = ['Arts', 'Science', 'Commerce', 'Computer Science', 'Engineering', 'Medicine'];

  useEffect(() => {
    const theme = domainThemes[selectedDomain];
    if (theme) {
      document.documentElement.style.setProperty('--bg', theme.bg);
      document.documentElement.style.setProperty('--accent', theme.accent);
      document.documentElement.style.setProperty('--accent-alt', theme.accentAlt);
    }
  }, [selectedDomain]);

  const handleAddTask = async (e: FormEvent) => {
    e.preventDefault();
    if (!newTask.trim() || !session?.user) return;
    
    const { data, error } = await supabase!.from('tasks').insert([
      { title: newTask, subject: selectedDomain, user_id: session.user.id }
    ]).select();

    if (!error && data && data.length > 0) {
      const inserted = { ...data[0], done: data[0].completed };
      setTasks([inserted, ...tasks]);
    }
    setNewTask('');
  };

  const handleToggleTask = async (task: any) => {
    const newDone = !task.done;
    // Optimistic UI update
    setTasks(tasks.map((t: any) => t.id === task.id ? { ...t, done: newDone } : t));
    
    // Supabase update
    await supabase!.from('tasks').update({ completed: newDone }).eq('id', task.id);
  };

  const handlePostForum = (e: FormEvent) => {
    e.preventDefault();
    if (!composerTitle.trim()) return;
    const post = {
      id: Date.now(),
      type: composerType,
      author: 'You',
      role: 'Student',
      time: 'Just now',
      title: composerTitle,
      body: composerBody,
      votes: 1,
      replies: 0
    };
    setForumPosts([post, ...forumPosts]);
    setComposerTitle('');
    setComposerBody('');
  };

  const handleChat = (e: FormEvent) => {
    e.preventDefault();
    if (!chatInput.trim()) return;
    const userMsg = chatInput;
    setChat([...chat, { role: 'user', msg: userMsg }]);
    setChatInput('');
    
    setTimeout(() => {
      setChat(prev => [...prev, { role: 'ai', msg: `I can certainly help you with "${userMsg}". (AI integration pending!)` }]);
    }, 800);
  };

  const handleGroupChat = (e: FormEvent) => {
    e.preventDefault();
    if (!groupMsg.trim()) return;
    setGroupChat([...groupChat, { role: 'user', author: 'You', msg: groupMsg }]);
    setGroupMsg('');
  };

  return (
    <div className="app-layout">
      {/* Sidebar Overlay */}
      <div className={`sidebar-overlay ${isSidebarOpen ? 'show' : ''}`} onClick={() => setIsSidebarOpen(false)}></div>
      
      {/* Left Sidebar */}
      <aside className={`sidebar ${isSidebarOpen ? 'open' : ''}`}>
        <div style={{ marginBottom: '40px', paddingLeft: '20px', paddingTop: '10px' }}>
          <h2 style={{ fontSize: '2rem', fontWeight: 800, margin: 0, letterSpacing: '-0.5px' }}>
            <span style={{ color: 'var(--ink)' }}>Study</span>
            <span style={{ color: 'var(--primary)' }}>Sync</span>
          </h2>
          <div style={{ width: '32px', height: '4px', background: 'var(--primary)', borderRadius: '2px', marginTop: '12px', opacity: 0.8 }}></div>
        </div>
        
        <nav className="sidebar-nav">
          {navSections.map(section => (
            <div key={section.title} style={{ marginBottom: '16px' }}>
              <div 
                onClick={() => toggleSection(section.title)}
                style={{ cursor: 'pointer', display: 'flex', justifyContent: 'space-between', alignItems: 'center', fontSize: '0.75rem', fontWeight: 700, textTransform: 'uppercase', letterSpacing: '0.05em', color: 'var(--secondary)', marginBottom: '8px', paddingLeft: '20px', paddingRight: '20px', opacity: 0.8, transition: 'all 0.2s' }}
              >
                {section.title}
                <span style={{ fontSize: '0.6rem', transform: expandedSections.includes(section.title) ? 'rotate(180deg)' : 'rotate(0deg)', transition: 'transform 0.3s' }}>��]</span>
              </div>
              <AnimatePresence>
                {expandedSections.includes(section.title) && (
                  <motion.div 
                    initial={{ height: 0, opacity: 0 }} 
                    animate={{ height: 'auto', opacity: 1 }} 
                    exit={{ height: 0, opacity: 0 }}
                    style={{ overflow: 'hidden', display: 'flex', flexDirection: 'column', gap: '4px' }}
                  >
                    {section.items.map(item => (
                      <button
                        key={item.id}
                        className={`sidebar-link ${(view === item.id || (view === 'live-room' && item.id === 'groups')) ? 'active' : ''}`}
                        onClick={() => setView(item.id)}
                      >
                        {item.label}
                      </button>
                    ))}
                  </motion.div>
                )}
              </AnimatePresence>
            </div>
          ))}
           <div style={{ marginTop: 'auto', display: 'flex', flexDirection: 'column', gap: '8px' }}>
            <button 
              className={`sidebar-link ${view === 'admin' ? 'active' : ''}`}
              onClick={() => setView('admin')}
              style={{ display: 'flex', alignItems: 'center', gap: '8px', color: 'var(--accent)' }}
            >
              Admin DB
            </button>
            <button 
              onClick={async () => {
                await supabase!.auth.signOut();
                setView('welcome');
              }}
              className="sidebar-link"
              style={{ display: 'flex', alignItems: 'center', gap: '8px', color: '#E53E3E' }}
            >
              Log Out
            </button>
          </div>
        </nav>
      </aside>

      {/* Main Content Area */}
      <main className="main-content">
        
        {/* Global Top Navigation */}
        <header className="global-topbar">
          <div style={{ display: 'flex', alignItems: 'center', gap: '24px' }}>
            <button className="icon-btn" onClick={() => setIsSidebarOpen(true)} style={{ fontSize: '1.2rem' }}>
              �f�,�
            </button>
            <h2 style={{ fontSize: '1.5rem', fontWeight: 800, margin: 0, letterSpacing: '-0.5px' }}>
              <span style={{ color: 'var(--ink)' }}>Study</span>
              <span style={{ color: 'var(--primary)' }}>Sync</span>
            </h2>
          </div>
          
          <div style={{ flex: 1, display: 'flex', justifyContent: 'center' }}>
            <div style={{ position: 'relative', width: '100%', maxWidth: '400px' }}>
              <input type="text" className="soft-input" placeholder="Search domains, courses..." style={{ marginBottom: 0, paddingLeft: '40px', borderRadius: '100px', border: '1px solid var(--border)' }} />
              <span style={{ position: 'absolute', left: '16px', top: '10px', opacity: 0.5 }}>�<U�ǥ,�</span>
            </div>
          </div>

          <div style={{ display: 'flex', alignItems: 'center', gap: '16px' }}>
            <button className="dash-icon-btn" style={{ position: 'relative' }}>
              a���<span style={{ position: 'absolute', top: 8, right: 8, width: 8, height: 8, background: 'var(--warning)', borderRadius: '50%' }}></span>
            </button>
            <div className="avatar" style={{ width: '40px', height: '40px', background: 'var(--primary)', fontSize: '1rem', cursor: 'pointer' }} onClick={() => setView('profile')}>ST</div>
          </div>
        </header>
        
        {/* Placeholder for Unbuilt Views */}
        {['analytics', 'visuals', 'library', 'notes', 'planner', 'ai', 'quiz', 'doubt', 'groups', 'live-room', 'events', 'notifications', 'files', 'online-class', 'search', 'mentors', 'settings', 'advanced'].includes(view) && (
          <div style={{ padding: '60px 20px', textAlign: 'center' }}>
            <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} className="soft-card" style={{ maxWidth: '600px', margin: '0 auto', padding: '60px 40px' }}>
              <div style={{ fontSize: '4rem', marginBottom: '24px' }}>�<U<�,�</div>
              <h1 style={{ fontSize: '2rem', fontWeight: 700, marginBottom: '16px' }}>{view.charAt(0).toUpperCase() + view.slice(1).replace('-', ' ')}</h1>
              <p style={{ fontSize: '1.1rem', opacity: 0.7, lineHeight: 1.6, marginBottom: '32px' }}>
                This section of the platform is currently under active development. We are building something awesome here!
              </p>
              <button className="btn-primary" onClick={() => setView('dashboard')}>Return to Dashboard</button>
