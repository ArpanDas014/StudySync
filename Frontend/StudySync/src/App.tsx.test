                          <strong style={{ flex: 1 }}>Sarah Jenkins</strong>
                          <span style={{ fontWeight: 600, color: 'var(--accent)' }}>945 XP</span>
                        </div>
                        <div className="leaderboard-item" style={{ background: 'var(--bg)', borderRadius: '8px', padding: '12px', margin: '8px 0', border: '1px solid var(--border)' }}>
