                    </button>
                    <button className={`quiz-option-btn ${quizSelection === 1 ? 'selected' : ''}`} onClick={() => setQuizSelection(1)}>
                      B. O(n)
                    </button>
                    <button className={`quiz-option-btn ${quizSelection === 2 ? 'selected' : ''}`} onClick={() => setQuizSelection(2)}>
                      C. O(log n)
                    </button>
                    <button className={`quiz-option-btn ${quizSelection === 3 ? 'selected' : ''}`} onClick={() => setQuizSelection(3)}>
                      D. O(n log n)
                    </button>
                  </div>
                </div>

                <div style={{ display: 'flex', justifyContent: 'space-between' }}>
                  <button className="btn-outline" disabled style={{ opacity: 0.5 }}>Previous</button>
                  <button className="btn-primary" onClick={() => setQuizSelection(null)}>Next Question</button>
                </div>
              </motion.div>
            )}

          </motion.div>
        )}



